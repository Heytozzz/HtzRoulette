{
  "name": "htzroulette",
  "version": "0.1.0",
  "description": "Twitch chat roulette app",
  "main": "src/main.js",
  "author": "Heytozzz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.heytozzz.htzroulette",
    "productName": "HtzRoulette",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraFiles": [
      {
        "from": "themes",
        "to": "themes"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "HtzRoulette-portable.exe"
    }
  }
}
